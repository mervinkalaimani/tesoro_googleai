SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Reading a blister card from a photograph, on /api/scan-car. Server-side only —
# no VITE_ prefix, because a key shipped to the browser is a key published.
# Without it the Scan button still appears and says it is not set up.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Set this if Google retires that one —
# the error the scan dialog shows names its own replacement.
GEMINI_MODEL=

# Optional. An OmniRoute server (or any OpenAI-compatible router) for the same
# scan. Set it and /api/scan-car asks it first, falling back to Gemini; leave it
# empty and nothing about the scan changes. Server-side only, no VITE_ prefix.
#
# It has to be reachable from wherever the app runs: a localhost address works
# in development and is unreachable from a Vercel deployment, so production
# either names a hosted router here or leaves this empty and stays on Gemini.
# e.g. http://localhost:20128
OMNIROUTE_BASE_URL=
# Optional. Defaults to "auto", which lets the router pick and fall back. Set a
# specific model if "auto" keeps choosing one that cannot read an image.
OMNIROUTE_MODEL=
# Optional. Only if the router requires a bearer token.
OMNIROUTE_API_KEY=

# Taking money for a plan, on /api/pay/order and /api/pay/verify. Both halves
# or neither: a key id with no secret can create no order, and the routes say
# so with a 501 rather than failing quietly.
#
# Server-side only, and the secret especially — it is what signs and verifies a
# payment, so a VITE_ prefix on it would publish the ability to forge one. The
# browser gets the key id from /api/pay/config at runtime instead of from the
# bundle, which also means rotating a key is a redeploy rather than a rebuild.
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Granting the plan a verified payment paid for writes a row the paying account
# cannot write itself, so payments need this as well as the two above. It is
# also what the admin push notifications need.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
