SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Reading a blister card from a photograph, on /api/scan-car. Server-side only —
# no VITE_ prefix, because a key shipped to the browser is a key published.
# Without it the Scan button still appears and says it is not set up.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Set this if Google retires that one —
# the error the scan dialog shows names its own replacement.
GEMINI_MODEL=
