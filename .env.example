SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Reading a blister card from a photograph, on /api/scan-car. Server-side only —
# no VITE_ prefix, because a key shipped to the browser is a key published.
# Without it the Scan button still appears and says it is not set up.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash. Set this if Google retires that one —
# the error the scan dialog shows names its own replacement.
GEMINI_MODEL=

# Optional. An OmniRoute server (or any OpenAI-compatible router) for the same
# scan. Set it and /api/scan-car asks it first, falling back to Gemini; leave it
# empty and nothing about the scan changes. Server-side only, no VITE_ prefix.
#
# It has to be reachable from wherever the app runs: a localhost address works
# in development and is unreachable from a Vercel deployment, so production
# either names a hosted router here or leaves this empty and stays on Gemini.
# e.g. http://localhost:20128
OMNIROUTE_BASE_URL=
# Optional. Defaults to "auto", which lets the router pick and fall back. Set a
# specific model if "auto" keeps choosing one that cannot read an image.
OMNIROUTE_MODEL=
# Optional. Only if the router requires a bearer token.
OMNIROUTE_API_KEY=
